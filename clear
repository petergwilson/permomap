<!DOCTYPE html>
<html>
<head>
    <title>Permolat Mapping System</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
    <script type="module" src="src/main.jsx"></script>
    <style>
        /* Responsive split: stack vertically on narrow screens */
        @media (max-width: 768px) {
            .split-row {
                display: block !important;
            }
            .split-col {
                width: 100% !important;
                margin-bottom: 0px;
            }
        }
        .split-row {
            display: flex;
            min-height: 300px;
            gap: 16px;
        }
        .split-col {
            display: flex;
            flex-direction: column;
            justify-content: stretch;
        }
        .map{
          height: 600px;
          width: 100%;
        }

        .modal {
          display: none; /* Hidden by default */
          position: fixed; /* Stay in place */
          z-index: 1; /* Sit on top */
          left: 0;
          top: 0;
          width: 100%;
          height: 100%;
          overflow: auto; /* Enable scroll if needed */
          background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
        }

    .modal-content {
        background-color: #fefefe;
        margin: 15% auto; /* 15% from the top and centered */
        padding: 20px;
        border: 1px solid #888;
        width: 80%;
        max-width: 500px;
    }

    .close {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
    }

    .close:hover,
    .close:focus {
        color: black;
        text-decoration: none;
        cursor: pointer;
    }
    #contextMenu {
      position: fixed;
      display: none;
      background: #fff;
      border: 1px solid #aaa;
      border-radius: 6px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.14);
      z-index: 1000;
      min-width: 180px;
    }
    #contextMenu .author {
      padding: 9px 16px 7px 16px;
      border-bottom: 1px solid #eee;
      font-size: 13px;
      color: #333;
    }
    #contextMenu .restore {
      cursor: pointer;
      padding: 8px 16px;
      transition: background 0.13s;
      font-size: 15px;
    }
    #contextMenu .restore:hover {
      background: #f3f5ff;
    }
    .strike-container {
  position: relative;
  display: inline-block;
}
.author-bubble {
  position: absolute;
  left: 0;
  top: -1.8em;
  background: #444;
  color: #fff;
  border-radius: 16px;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: bold;
  box-shadow: 0 1px 4px rgba(0,0,0,0.2);
  user-select: none;
  pointer-events: none;
  z-index: 10;
}
 /* User color underline and strikethrough (example: data attributes for style) */
  .ql-user-ins {
    text-decoration: underline;
    text-underline-position: under;
    font-weight: bold;
  }
  .ql-user-del {
    text-decoration: line-through;
    font-weight: bold;
    opacity: 0.7;
  }

/* Hover-only tooltip for [data-username] elements */
[data-username]{
  position: relative;
  --tt-bg: #111827;
  --tt-fg: #fff;
  --tt-radius: .5rem;
  --tt-gap: 8px;
  --tt-pad-y: .35rem;
  --tt-pad-x: .5rem;
  --tt-shadow: 0 6px 20px rgba(0,0,0,.22);
  --tt-z: 20;
}

[data-username]::after{
  content: attr(data-username);
  position: absolute;
  left: 50%;
  bottom: calc(100% + var(--tt-gap));
  transform: translateX(-50%) translateY(4px) scale(.98);
  background: var(--tt-bg);
  color: var(--tt-fg);
  font: 600 .75rem/1.25 system-ui,-apple-system,Segoe UI,Roboto,"Helvetica Neue",Arial;
  padding: var(--tt-pad-y) var(--tt-pad-x);
  border-radius: var(--tt-radius);
  box-shadow: var(--tt-shadow);
  white-space: pre-wrap;          /* allows line break */
  max-width: 28ch;
  z-index: var(--tt-z);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity .15s ease, transform .15s ease, visibility 0s linear .15s;
}

/* Show tooltip */
[data-username]:hover::after,
[data-username]:focus-visible::after{
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(0) scale(1);
  transition: opacity .15s ease, transform .15s ease, visibility 0s;
}

/* If JS set data-ts, use that on the second line */
[data-username][data-ts]:hover::after,
[data-username][data-ts]:focus-visible::after{
  content: attr(data-username) "\A" attr(data-ts);
}

/* Fallback: if no data-ts, but a raw timestamp exists, show it raw */
[data-username][timestamp]:hover:not([data-ts])::after,
[data-username][timestamp]:focus-visible:not([data-ts])::after{
  content: attr(data-username) "\A" attr(timestamp);
}

@media (prefers-reduced-motion: reduce){
  [data-username]::after{ transition: none; }
}
    </style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const nodes = document.querySelectorAll('[data-username][timestamp]');
  // Localized date/time (viewer’s locale & timezone)
  const fmt = new Intl.DateTimeFormat(undefined, {
    dateStyle: 'medium',
    timeStyle: 'short'
  });

  nodes.forEach(el => {
    const raw = (el.getAttribute('timestamp') || '').trim();
    let d;

    if (/^\d+$/.test(raw)) {
      // Numeric epoch: detect seconds vs milliseconds
      let n = Number(raw);
      if (n < 1e11) n *= 1000;   // treat 10-digit values as seconds
      d = new Date(n);
    } else {
      // Try to parse ISO/date strings as a loose fallback
      const t = Date.parse(raw);
      if (!Number.isNaN(t)) d = new Date(t);
    }

    if (d && !Number.isNaN(d.getTime())) {
      const pretty = fmt.format(d);
      el.setAttribute('data-ts', pretty);
      // Optional: native tooltip on long hover
      if (!el.hasAttribute('title')) {
        el.setAttribute('title', `${el.getAttribute('data-username')} • ${pretty}`);
      }
    }
  });
});
</script>
</head>
