# Deployment Configuration
# Copy this to .env.deploy and set your actual values

# Remote Server Configuration
REMOTE_HOST=your-remote-host.com
REMOTE_USER=peter

# Local mount point for SSH tunnel (SSHFS)
REMOTE_MOUNT=/mnt/remote

# Remote Database Configuration
REMOTE_DB=gis
REMOTE_PG_USER=postgres

# Local Database Configuration
LOCAL_DB=gis
LOCAL_USER=postgres
