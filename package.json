{
  "name": "permomap",
  "version": "1.0.0",
  "description": "Permolat Mapping System",
  "main": "src/main.mjs",
  "scripts": {
    "start": "cross-env FEATURE_SERVER_PORT=9000 docker compose up --build",
    "start:dev": "concurrently --names \"CLIENT,SERVER,DOCKER\" --prefix-colors \"cyan,green,yellow\" \"npm run start:client\" \"npm run start:server\" \"npm run start:docker-infra\"",
    "start:client": "cross-env FEATURE_SERVER_PORT=9000 vite",
    "start:server": "cross-env DATABASE_NAME=permolatmap node backend/server.mjs",
    "start:docker-infra": "cross-env FEATURE_SERVER_PORT=9000 docker compose up -d --build postgres pg_featureserv otel-collector jaeger prometheus loki grafana",
    "stop": "docker compose down",
    "build": "vite build",
    "serve": "vite preview",
    "server:dev": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gis NODE_ENV=development node backend/server.mjs",
    "pg_featureserv": "cd /home/peter/pg_featureserv && ./pg_featureserv --config /home/peter/permomap/pg_featurserv_config/pg_featureserv.dev.toml",
    "dev": "concurrently \"npm start\" \"npm run server:dev\" \"npm run pg_featureserv\" --names \"client,server,geoserver\" --prefix-colors \"cyan,blue,red\"",
    "dev:all": "concurrently \"npm run server:dev\" \"npm run pg_featureserv\" --names \"server,geoserver\" --prefix-colors \"blue,red\"",
    "db:backup": "bash scripts/backup-database.sh",
    "db:deploy": "bash scripts/deploy-database.sh",
    "deploy:full": "npm run build && npm run db:deploy"
  },
  "devDependencies": {
    "@babel/cli": "^7.27.2",
    "@babel/core": "^7.27.3",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "concurrently": "^9.2.1",
    "sass-embedded": "^1.89.0",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "ol": "latest",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-linkedin-oauth2": "^2.0.0",
    "passport-microsoft": "^2.1.0",
    "pg": "^8.16.0"
  }
}
