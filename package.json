{
  "name": "permomap",
  "version": "1.0.0",
  "description": "Permolat Mapping System",
  "main": "src/main.mjs",
  "scripts": {
    "start": "cross-env FEATURE_SERVER_PORT=9000 docker compose up --build",
    "start:dev": "concurrently --names \"CLIENT,SERVER,DOCKER\" --prefix-colors \"cyan,green,yellow\" \"npm run start:client\" \"npm run start:server\" \"npm run start:docker-infra\"",
    "start:client": "cross-env FEATURE_SERVER_PORT=9000 vite",
    "start:server": "cross-env DATABASE_NAME=permolatmap node backend/server.mjs",
    "start:docker-infra": "cross-env FEATURE_SERVER_PORT=9000 docker compose up -d --build postgres pg_featureserv otel-collector jaeger prometheus loki grafana",
    "stop": "docker compose down",
    "build": "vite build",
    "serve": "vite preview"
  },
  "devDependencies": {
    "@babel/cli": "^7.27.2",
    "@babel/core": "^7.27.3",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "sass-embedded": "^1.89.0",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "ice": "^3.7.100",
    "nytimes-ice": "^0.6.3",
    "ol": "latest",
    "pg": "^8.16.0"
  }
}
