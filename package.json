{
  "name": "permomap",
  "version": "1.0.0",
  "description": "Permolat Mapping System",
  "main": "src/main.mjs",
  "scripts": {
    "start": "cross-env FEATURE_SERVER_PORT=9000 docker compose up --build",
    "start:dev": "concurrently --names \"CLIENT,SERVER,DOCKER\" --prefix-colors \"cyan,green,yellow\" \"npm run start:client\" \"npm run start:server\" \"npm run start:docker-infra\"",
    "start:client": "cross-env FEATURE_SERVER_PORT=9000 vite",
    "start:server": "cross-env DATABASE_NAME=permolatmap node backend/server.mjs",
    "start:docker-infra": "cross-env FEATURE_SERVER_PORT=9000 docker compose up -d --build postgres pg_featureserv otel-collector jaeger prometheus loki grafana",
    "stop": "docker compose down",
    "build": "vite build",
    "serve": "vite preview"
  },
  "devDependencies": {
    "@babel/cli": "^7.27.2",
    "@babel/core": "^7.27.3",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "sass-embedded": "^1.89.0",
    "vite": "^7.1.11"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.64.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.205.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.205.0",
    "@opentelemetry/exporter-otlp-http": "^0.26.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.205.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-metrics": "^2.1.0",
    "@opentelemetry/sdk-trace-node": "^2.1.0",
    "@opentelemetry/instrumentation-express": "^0.54.0",
    "@opentelemetry/instrumentation-http": "^0.205.0",
    "@opentelemetry/instrumentation-pg": "^0.58.0",
    "@opentelemetry/sdk-node": "^0.205.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "ice": "^3.7.100",
    "nytimes-ice": "^0.6.3",
    "ol": "^10.5.0",
    "pg": "^8.16.0"
  }
}
