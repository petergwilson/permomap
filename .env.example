# Permomap Environment Configuration

# Feature Server Port (for development and Docker)
FEATURE_SERVER_PORT=9000

# Database Configuration
DATABASE_NAME=permolatmap

# Vite Base URL Configuration
# For local development (default):
VITE_BASE_URL=/

# For production deployment:
# VITE_BASE_URL=https://www.wilsonenv.nz/permomap/

# For custom subdirectory deployments:
# VITE_BASE_URL=/my-custom-path/
